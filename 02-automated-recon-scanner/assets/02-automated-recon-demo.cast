[165.080569, "o", "\u001b[7m\u001b[4m\u001b[37m2.\u001b[24m\u001b[39m\u001b[7m Update the Lab 02 r\u001b[7mo\u001b[7mw in your root \u001b[1m\u001b[7m\u001b[34m`\u001b[0m\u001b[39m\u001b[7m\u001b[4m\u001b[37mREADME.md\u001b[24m\u001b[39m\u001b[1m\u001b[7m\u001b[34m`\u001b[0m\u001b[39m\u001b[7m \u001b[1m\u001b[7m\u001b[34m(\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[34m`\u001b[0m\u001b[39m\u001b[1m\u001b[7m~/Kali-Dev-2022/appli\u001b[1m\u001b[7me\u001b[1m\u001b[7md-security-and-dev-labs/README.md\u001b[0m\u001b[1m\u001b[7m\u001b[34m`\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[34m)\u001b[0m\u001b[39m\u001b[7m to link to \u001b[1m\u001b[7m\u001b[34m`\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[34m[\u001b[0m\u001b[39m\u001b[7m\u001b[4m\u001b[37mV\u001b[7m\u001b[4m\u001b[37mi\u001b[7m\u001b[4m\u001b[37mew\u001b[24m\u001b[39m\u001b[7m Lab \u001b[1m\u001b[7m\u001b[34m&\u001b[0m\u001b[39m\u001b[7m \u001b[7m\u001b[4m\u001b[37mDemo\u001b[24m\u001b[1m\u001b[7m\u001b[34m]\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[34m(\u001b[0m\u001b[39m\u001b[7m\u001b[4m\u001b[37m./02-automated-recon-scanner\u001b[24m\u001b[1m\u001b[7m\u001b[34m)\u001b[0m\u001b[24m\u001b[39m\u001b[1m\u001b[7m\u001b[34m`\u001b[0m\u001b[39m\u001b[7m, the\u001b[7mn\u001b[7m push to GitHub:\u001b[27m\u001b[K\r\r\n\u001b[7m\u001b[4m\u001b[37m```bash\u001b[27m\u001b[24m\u001b[39m\u001b[K\r\r\n\u001b[7m\u001b[4m\u001b[37mcd ~/Kali-Dev-2022/applied-security-and-dev-labs\u001b[27m\u001b[24m\u001b[39m\u001b[K\r\r\n\u001b[7m\u001b[4m\u001b[37mgit add .\u001b[27m\u001b[24m\u001b[39m\u001b[K\r\r\n\u001b[7m\u001b[4m\u001b[37mgit commit -m \"feat\u001b[24m\u001b[1m\u001b[7m\u001b[34m(\u001b[0m\u001b[39m\u001b[7m\u001b[4m\u001b[37mlab-02\u001b[24m\u001b[1m\u001b[7m\u001b[34m)\u001b[0m\u001b[39m\u001b[7m\u001b[4m\u001b[37m: add automated Nmap rec\u001b[7m\u001b[4m\u001b[37mo\u001b[7m\u001b[4m\u001b[37mn scanner and UFW hardening demo\"\u001b[27m\u001b[24m\u001b[39m\u001b[K\r\r\n\u001b[7m\u001b[4m\u001b[37mgit push -u origin main\u001b[27m\u001b[24m\u001b[39m\u001b[K"]
