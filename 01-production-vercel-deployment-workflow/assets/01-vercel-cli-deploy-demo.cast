[702.265678, "o", "\u001b[9A\u001b[4C\u001b[27m\u001b[36mc\u001b[27m\u001b[36md\u001b[39m\u001b[27m \u001b[27m\u001b[1m~\u001b[27m\u001b[1m/\u001b[27m\u001b[1mh\u001b[27m\u001b[1mu\u001b[27m\u001b[1mm\u001b[27m\u001b[1ma\u001b[27m\u001b[1mn\u001b[27m\u001b[1mi\u001b[27m\u001b[1mt\u001b[27m\u001b[1my\u001b[27m\u001b[1m-\u001b[27m\u001b[1ms\u001b[27m\u001b[1my\u001b[27m\u001b[1mb\u001b[27m\u001b[1mi\u001b[27m\u001b[1ml\u001b[27m\u001b[1m-\u001b[27m\u001b[1ms\u001b[27m\u001b[1mt\u001b[27m\u001b[1ma\u001b[27m\u001b[1mr\u001b[27m\u001b[1mt\u001b[27m\u001b[1me\u001b[27m\u001b[1mr\u001b[27m\u001b[1m/\u001b[27m\u001b[1mf\u001b[27m\u001b[1mr\u001b[27m\u001b[1mo\u001b[27m\u001b[1mn\u001b[27m\u001b[1mt\u001b[27m\u001b[1me\u001b[27m\u001b[1mn\u001b[27m\u001b[1md\u001b[0m\u001b[1B\r\u001b[27m\u001b[1m\u001b[34m{\u001b[0m\u001b[39m\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m\u001b[36mc\u001b[27m\u001b[36ma\u001b[27m\u001b[36mt\u001b[39m\u001b[27m \u001b[27m\u001b[1ma\u001b[27m\u001b[1mp\u001b[27m\u001b[1mp\u001b[27m\u001b[1m/\u001b[27m\u001b[1ma\u001b[27m\u001b[1mp\u001b[27m\u001b[1mi\u001b[27m\u001b[1m/\u001b[27m\u001b[1ma\u001b[27m\u001b[1mu\u001b[27m\u001b[1mt\u001b[27m\u001b[1mh\u001b[27m\u001b[1m/\u001b[27m\u001b[1mh\u001b[27m\u001b[1mu\u001b[27m\u001b[1mm\u001b[27m\u001b[1ma\u001b[27m\u001b[1mn\u001b[27m\u001b[1mi\u001b[27m\u001b[1mt\u001b[27m\u001b[1my\u001b[27m\u001b[1m/\u001b[27m\u001b[1mr\u001b[27m\u001b[1mo\u001b[27m\u001b[1mu\u001b[27m\u001b[1mt\u001b[27m\u001b[1me\u001b[27m\u001b[1m.\u001b[27m\u001b[1mt\u001b[27m\u001b[1ms\u001b[0m\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m\u001b[36me\u001b[27m\u001b[36mc\u001b[27m\u001b[36mh\u001b[27m\u001b[36mo\u001b[39m\u001b[27m \u001b[27m\u001b[33m\"\u001b[27m\u001b[33m=\u001b[27m\u001b[33m=\u001b[27m\u001b[33m=\u001b[27m\u001b[33m \u001b[27m\u001b[33mC\u001b[27m\u001b[33mA\u001b[27m\u001b[33mL\u001b[27m\u001b[33mL\u001b[27m\u001b[33mB\u001b[27m\u001b[33mA\u001b[27m\u001b[33mC\u001b[27m\u001b[33mK\u001b[27m\u001b[33m \u001b[27m\u