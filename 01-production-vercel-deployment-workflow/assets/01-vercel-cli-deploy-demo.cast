[969.411955, "o", ">....                                                                    \r\n\u001b[7m  \u001b[7m\u001b[4m\u001b[37mtry\u001b[24m\u001b[39m\u001b[7m \u001b[1m\u001b[7m\u001b[32m{\u001b[0m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[7m    \u001b[7m\u001b[4m\u001b[37mconst\u001b[24m\u001b[39m\u001b[7m tokenData = await sdk.exchangeCodeForToken\u001b[1m\u001b[7m\u001b[35m(\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[33m{\u001b[0m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[7m      code,\u001b[27m\u001b[K\r\r\n\u001b[7m      codeVerifier: storedVerifier,\u001b[27m\u001b[K\r\r\n\u001b[7m    \u001b[1m\u001b[7m\u001b[33m}\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[35m)\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[34m;\u001b[0m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    \u001b[7m\u001b[4m\u001b[37mconst\u001b[24m\u001b[39m\u001b[7m verification = await sdk.verifyPreset\u001b[1m\u001b[7m\u001b[35m(\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[33m{\u001b[0m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[7m      accessToken: tokenData.accessToken,\u001b[27m\u001b[K\r\r\n\u001b[7m      preset: \u001b[7m\u001b[33m'is_human'\u001b[39m\u001b[7m,\u001b[27m\u001b[K\r\r\n\u001b[7m    \u001b[1m\u001b[7m\u001b[33m}\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[35m)\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[34m;\u001b[0m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    \u001b[7m\u001b[36mreturn\u001b[39m\u001b[7m NextResponse.json\u001b[1m\u001b[7m\u001b[35m(\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[33m{\u001b[0m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[7m      authenticated: true,\u001b[27m\u001b[K\r\r\n\u001b[7m      isVerifiedHuman: Boolean\u001b[1m\u001b[7m\u001b[36m(\u001b[0m\u001b[39m\u001b[7mverification.value \u001b[1m\u001b[7m\u001b[34m&&\u001b[0m\u001b[39m\u001b[7m \u001b[7m\u001b[4m\u001b[37mverification.status\u001b[24m\u001b[39m\u001b[7m === \u001b[7m\u001b[33m'\u001b[7m\u001b[33mvalid'\u001b[39m\u001b[1m\u001b[7m\u001b[36m)\u001b[0m\u001b[24m\u001b[39m\u001b[7m,\u001b[27m\u001b[K\r\r\n\u001b[7m      \u001b[7m\u001b[4m\u001b[37mhumanId:\u001b[24m\u001b[39m\u001b[7m tokenData.appScopedUserId,\u001b[27m\u001b[K\r\r\n\u001b[7m    \u001b[1m\u001b[7m\u001b[33m}\u001b[0m\u001b[24m\u001b[39m\u001b[1m\u001b[7m\u001b[35m)\u001b[0m\u001b[24m\u001b[39m\u001b[1m\u001b[7m\u001b[34m;\u001b[0m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[7m  \u001b[1m\u001b[7m\u001b[32m}\u001b[0m\u001b[24m\u001b[39m\u001b[7m catch \u001b[1m\u001b[7m\u001b[32m(\u001b[0m\u001b[39m\u001b[7merr: any\u001b[1m\u001b[7m\u001b[32m)\u001b[0m\u001b[39m\u001b[7m \u001b[1m\u001b[7m\u001b[32m{\u001b[0m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[7m    \u001b[7m\u001b[36mreturn\u001b[39m\u001b[7m NextResponse.json\u001b[1m\u001b[7m\u001b[35m(\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[33m{\u001b[0m\u001b[39m\u001b[7m error: err.message || \u001b[7m\u001b[33m'Verification failed'\u001b[39m\u001b[7m \u001b[1m\u001b[7m\u001b[33m}\u001b[0m\u001b[39m\u001b[7m,\u001b[7m \u001b[1m\u001b[7m\u001b[33m{\u001b[0m\u001b[39m\u001b[7m status: 500 \u001b[1m\u001b[7m\u001b[33m}\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[35m)\u001b[0m\u001b[39m\u001b[1m\u001b[7m\u001b[34m;\u001b[0m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[7m  \u001b[1m\u001b[7m\u001b[32m}\u001b[0m\u001b[24m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[1m\u001b[7m\u001b[34m}\u001b[0m\u001b[24m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[7m\u001b[4m\u001b[37mEOF\u001b[24m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[1m\u001b[7m\u001b[30m# 3. Verify the production build passes cleanly!\u001b[0m\u001b[39m\u001b[27m\u001b[K\r\r\n\u001b[7m\u001b[36mnpm\u001b[39m\u001b[7m run build\u001b[27m\u001b[K"]
