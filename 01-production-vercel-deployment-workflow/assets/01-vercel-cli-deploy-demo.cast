[128.357028, "o", "import { NextResponse } from 'next/server';\r\nimport { HumanitySDK } from '@humanity-org/connect-sdk';\r\n\r\nexport async function GET() {\r\n  const sdk = new HumanitySDK({\r\n    clientId: process.env.HUMANITY_CLIENT_ID!,\r\n    clientSecret: process.env.HUMANITY_CLIENT_SECRET!,\r\n    redirectUri: process.env.HUMANITY_REDIRECT_URI!,\r\n    environment: (process.env.HUMANITY_ENVIRONMENT as 'sandbox' | 'production') || 'sandbox',\r\n  });\r\n\r\n  const { url, codeVerifier, state } = await sdk.buildAuthUrl({\r\n    scopes: ['openid', 'profile', 'identity:verified'],\r\n  });\r\n\r\n  const response = NextResponse.redirect(url);\r\n  response.cookies.set('humanity_code_verifier', codeVerifier, { httpOnly: true, path: '/' });\r\n  response.cookies.set('humanity_oauth_state', state, { httpOnly: true, path: '/' });\r\n\r\n  return response;\r\n}\r\n"]
[128.35785, "o", "=== CALLBACK ROUTE ==="]
[128.357943, "o", "\r\n"]
[128.360549, "o", "import { NextRequest, NextResponse } from 'next/server';\r\nimport { HumanitySDK } from '@humanity-org/connect-sdk';\r\n\r\nexport async function GET(request: NextRequest) {\r\n  const { searchParams } = new URL(request.url);\r\n  const code = searchParams.get('code');\r\n  const returnedState = searchParams.get('state');\r\n\r\n  const storedVerifier = request.cookies.get('humanity_code_verifier')?.value;\r\n  const storedState = request.cookies.get('humanity_oauth_state')?.value;\r\n\r\n  if (!code || !storedVerifier || returnedState !== storedState) {\r\n    return NextResponse.json({ error: 'Invalid OAuth state or missing code' }, { status: 400 });\r\n  }\r\n\r\n  const sdk = new HumanitySDK({\r\n    clientId: process.env.HUMANITY_CLIENT_ID!,\r\n    clientSecret: process.env.HUMANITY_CLIENT_SECRET!,\r\n    redirectUri: process.env.HUMANITY_REDIRECT_URI!,\r\n    environment: (process.env.HUMANITY_ENVIRONMENT as 'sandbox' | 'production') || 'sandbox',\r\n  });\r\n\r\n  try {\r\n    const tokenData = await sdk.exchangeCodeForToken({\r\n      code,\r\n      codeVerifier: storedVerifier,\r\n    });\r\n\r\n    const verification = await sdk.verifyCredential({\r\n      accessToken: tokenData.access_token,\r\n      credentialType: 'identity:verified',\r\n    });\r\n\r\n    return NextResponse.json({\r\n      authenticated: true,\r\n      isVerifiedHuman: verification.valid,\r\n      humanId: verification.subject,\r\n    });\r\n  } catch (err: any) {\r\n    return NextResponse.json({ error: err.message || 'Verification failed' }, { status: 500 });\r\n  }\r\n}\r\n"]
